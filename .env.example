# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# GitHub — PAT with `repo` scope so the agent can clone and push branches
GITHUB_TOKEN=ghp_...
YARDSALE_REPO_URL=https://github.com/jashadev42/yardsale.git

# Optional: where the agent clones Yardsale for editing (default: ./.yardsale-workdir)
# YARDSALE_WORK_DIR=/tmp/yardsale

# Optional: git commit identity
GIT_USER_EMAIL=agent@yardsale.local
GIT_USER_NAME=Yardsale Agent

# Optional: hard daily cost cap in USD (default: 5.0)
DAILY_COST_CAP_USD=5.0

# Optional: dashboard state sync — pick ONE of the three.
#
# Option A — Gist (recommended for Render + hosted dashboard).
# Create a secret Gist on GitHub containing an empty agent_state.json file,
# then put the gist ID here. The agent PATCHes it on every update and the
# dashboard fetches https://gist.githubusercontent.com/<user>/<id>/raw/agent_state.json
# DASHBOARD_GIST_ID=abc123def456
#
# Option B — local file (for dashboards running on the same machine).
# DASHBOARD_STATE_PATH=/shared/agent_state.json
#
# Option C — HTTP webhook (if you have your own endpoint).
# DASHBOARD_WEBHOOK_URL=https://your-dashboard.example.com/api/state
